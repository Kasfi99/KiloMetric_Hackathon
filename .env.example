PORT=3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional OCR model override; defaults to GEMINI_MODEL. Must support images/PDF and structured output.
GEMINI_OCR_MODEL=
# Optional model for driver route explanations; defaults to GEMINI_MODEL. Must answer within ~20 s.
# Measured 17 Oct 2026: gemini-flash-lite-latest ≈ 5 s; gemini-3.7-flash 503 or ≈ 87 s.
GEMINI_ROUTE_MODEL=gemini-flash-lite-latest
# Enable Google Maps Platform Routes API for automatic delivery-order distance.
MAPS_API_KEY=
# OpenRouteService key (free at openrouteservice.org) for driver route alternatives with the driving-hgv truck profile.
# Without it, /api/routes/preview returns clearly labelled fixture routes.
ORS_API_KEY=
TRUCK_ROUTING_PROVIDER=
TRUCK_ROUTING_API_KEY=
ELEVATION_API_KEY=
# Local demo: public accounts use demo1234.
DEMO_MODE=1
# A fresh demo database also gets three assigned demo delivery orders for driver@demo.id. Set 0 to skip.
# Existing data/fleet.json is not changed; delete it (after backing up) to reseed.
DEMO_ORDERS=1
# For a fresh non-demo database, set DEMO_MODE=0 and bootstrap an admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# For deployment behind an HTTPS reverse proxy:
APP_ORIGIN=
COOKIE_SECURE=0
HOST=127.0.0.1
