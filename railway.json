{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm run build",
    "watchPatterns": ["server.js", "lib/**", "src/**", "public/**", "index.html", "package.json", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "node server.js --production",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
